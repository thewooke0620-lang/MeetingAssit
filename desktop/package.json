{
  "name": "meetingassit-desktop",
  "productName": "MeetingAssit",
  "version": "1.0.0",
  "description": "회의 통역 도우미 데스크톱 앱",
  "author": "thewooke0620-lang",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "smoke": "xvfb-run -a node ../tests/desktop.smoke.js"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.thewooke0620.meetingassit",
    "productName": "MeetingAssit",
    "copyright": "thewooke0620-lang",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "회의 통역 도우미",
      "artifactName": "MeetingAssit-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MeetingAssit-${version}-portable.exe"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thewooke0620-lang/MeetingAssit.git"
  }
}
